-- ============ ANIMAÇÕES ============
local animOn=false

local function anim(c)
	local h=c:FindFirstChildOfClass("Humanoid")
	if not h then return end
	local a=c:FindFirstChild("Animate")
	if a then a.Disabled=true end
	local an=h:FindFirstChildOfClass("Animator")
	if an then
		for _,t in ipairs(an:GetPlayingAnimationTracks()) do
			t:Stop()
		end
	end
end

mt.Activated:Connect(function()
	animOn=not animOn
	toggle(mt,mc,animOn)
	if animOn and P.Character then anim(P.Character) end
end)

P.CharacterAdded:Connect(function(c)
	if animOn then task.wait(.5);anim(c) end
end)

-- ============ ANTI AFK SEGURO ============
local antiAfkOn=false

local function loopAntiAfk()
	task.spawn(function()
		while antiAfkOn do
			for _=1,240 do
				if not antiAfkOn then return end
				task.wait(1)
			end
			if not antiAfkOn then return end
			local char=P.Character
			local hum=char and char:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health>0 then
				pcall(function() hum.Jump=true end)
			end
		end
	end)
end

kt.Activated:Connect(function()
	antiAfkOn=not antiAfkOn
	toggle(kt,kc,antiAfkOn)
	if antiAfkOn then
		loopAntiAfk()
		print("[PaivaScript] Anti AFK ATIVADO")
	else
		print("[PaivaScript] Anti AFK DESATIVADO")
	end
end)

