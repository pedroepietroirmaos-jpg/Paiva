local function btn(p,s,pos,t,bg,hoverBg,isToggle)
	local b=Instance.new("TextButton",p)
	b.Size=s;b.Position=pos;b.Text=t
	b.BackgroundColor3=bg or C(28,42,60)
	b.TextColor3=Color3.new(1,1,1)
	b.Font=Enum.Font.GothamBold;b.TextSize=12
	b.AutoButtonColor=false
	Instance.new("UICorner",b).CornerRadius=UDim.new(0,7)

	local bs=Instance.new("UIStroke",b)
	bs.Color=C(60,80,110)
	bs.Thickness=1
	bs.Transparency=.6

	local baseBg=b.BackgroundColor3
	local hBg=hoverBg or C(40,60,85)

	if not isToggle then
		b.MouseEnter:Connect(function()
			TweenService:Create(b,TweenInfo.new(.15),{BackgroundColor3=hBg}):Play()
			TweenService:Create(bs,TweenInfo.new(.15),{Color=neon,Transparency=.2}):Play()
		end)
		b.MouseLeave:Connect(function()
			TweenService:Create(b,TweenInfo.new(.15),{BackgroundColor3=baseBg}):Play()
			TweenService:Create(bs,TweenInfo.new(.15),{Color=C(60,80,110),Transparency=.6}):Play()
		end)
	else
		b.MouseEnter:Connect(function()
			TweenService:Create(bs,TweenInfo.new(.15),{Color=neon,Transparency=.2}):Play()
		end)
		b.MouseLeave:Connect(function()
			TweenService:Create(bs,TweenInfo.new(.15),{Color=C(60,80,110),Transparency=.6}):Play()
		end)
	end

	b.MouseButton1Down:Connect(function()
		TweenService:Create(b,TweenInfo.new(.08),{Size=UDim2.new(s.X.Scale,s.X.Offset-2,s.Y.Scale,s.Y.Offset-2)}):Play()
	end)
	b.MouseButton1Up:Connect(function()
		TweenService:Create(b,TweenInfo.new(.1),{Size=s}):Play()
	end)

	return b
end

