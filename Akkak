	TweenService:Create(mini,TweenInfo.new(.2),{BackgroundColor3=C(25,40,60)}):Play()
	TweenService:Create(miniTxt,TweenInfo.new(.2),{TextSize=34}):Play()
end)
mini.MouseLeave:Connect(function()
	TweenService:Create(mini,TweenInfo.new(.2),{BackgroundColor3=C(18,28,42)}):Play()
	TweenService:Create(miniTxt,TweenInfo.new(.2),{TextSize=30}):Play()
end)

makeDraggable(mini, mini, function()
	main.Visible=true
	mini.Visible=false
end)

min.Activated:Connect(function()
	main.Visible=false
	mini.Visible=true
end)

close.Activated:Connect(function()
	gui:Destroy()
end)

G.DescendantAdded:Connect(function(o)
	if o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox") then
		if not o:IsDescendantOf(gui) then
			pcall(function() o.Font=current end)
		end
	end
end)

print("[PaivaScript] Carregado com sucesso!")
